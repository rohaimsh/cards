{
  "platform": {"apiRuntime": "node:22"},
  "navigationFallback": {"rewrite": "/index.html", "exclude": ["/api/*", "/card.html", "/admin.html", "/sw.js", "/*.{png,jpg,svg,ico,json,md}"]},
  "routes": [
    {"route": "/admin.html", "headers": {"X-Robots-Tag": "noindex, nofollow"}},
    {"route": "/api/*", "allowedRoles": ["anonymous"], "headers": {"Cache-Control": "no-store"}}
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(self), geolocation=()",
    "Cache-Control": "no-cache"
  },
  "mimeTypes": {".vcf": "text/vcard"}
}
